+                if (isEmpty(current) || !current.isSimilar(requested)) continue;
+                int taking = Math.min(remaining, current.getAmount());
+                int left = current.getAmount() - taking;
+                if (left <= 0) inventory.setItem(slot, null);
+                else {
+                    ItemStack clone = current.clone();
+                    clone.setAmount(left);
+                    inventory.setItem(slot, clone);
+                }
+                remaining -= taking;
+            }
+            if (remaining > 0) {
+                ItemStack offhand = inventory.getItemInOffHand();
+                if (!isEmpty(offhand) && offhand.isSimilar(requested)) {
+                    int taking = Math.min(remaining, offhand.getAmount());

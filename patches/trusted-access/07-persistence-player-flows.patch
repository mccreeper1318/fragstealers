+    public static List<ItemStack> difference(ItemStack[] source, ItemStack[] subtract) {
+        ItemStack[] remaining = cloneContents(source);
+        List<ItemStack> subtracting = new ArrayList<>();
+        for (ItemStack item : subtract) {
+            if (!isEmpty(item)) subtracting.add(item.clone());
+        }
+        removeMatching(remaining, subtracting);
+        List<ItemStack> result = new ArrayList<>();

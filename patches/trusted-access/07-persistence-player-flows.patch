+    public static List<ItemStack> removeMatching(ItemStack[] contents, List<ItemStack> items) {
+        List<ItemStack> missing = new ArrayList<>();
+        for (ItemStack requested : items) {
+            if (isEmpty(requested)) continue;
+            int remaining = requested.getAmount();
+            for (int slot = 0; slot < contents.length && remaining > 0; slot++) {
+                ItemStack current = contents[slot];
+                if (isEmpty(current) || !current.isSimilar(requested)) continue;
+                int taking = Math.min(remaining, current.getAmount());
+                int left = current.getAmount() - taking;
+                if (left <= 0) contents[slot] = null;
+                else {
+                    ItemStack clone = current.clone();
+                    clone.setAmount(left);
+                    contents[slot] = clone;
+                }
+                remaining -= taking;
+            }
+            if (remaining > 0) {
+                ItemStack clone = requested.clone();
+                clone.setAmount(remaining);
+                missing.add(clone);
+            }
+        }
+        return missing;
+    }
